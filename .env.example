# Copia para .env e preenche o que quiseres usar. Todas as variáveis são opcionais.

# Variantes a vigiar (por omissão: Bordô, Glaciar, Prateado e Preto / 256 GB)
# Cores separadas por vírgula, tal como no site: Bordô, Glaciar, Prateado, Preto
# TARGET_COLORS=Bordô,Glaciar,Prateado,Preto
# TARGET_STORAGE=256 GB

# Intervalo entre verificações, em segundos (por omissão: 60)
# INTERVAL_SECONDS=60

# Notificação push via https://ntfy.sh — instala a app ntfy e subscreve este tópico
# NTFY_TOPIC=iphone-joao-xyz

# Mensagem num canal do Discord via webhook (ver instruções no chat / README)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXXXXXXXXXXX/yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy

# O teu ID numérico do Discord, para a mensagem te dar tag (som/notificação real).
# Obtém-se em: Definições > Avançadas > Modo de Programador (ativa) > botão direito no teu nome > Copiar ID do Utilizador
# DISCORD_USER_ID=123456789012345678

# Notificação via Telegram — cria um bot com o @BotFather e envia-lhe uma mensagem
# para obteres o teu chat id (ex: com @userinfobot ou a API getUpdates)
# TELEGRAM_TOKEN=123456:ABC-DEF...
# TELEGRAM_CHAT=123456789
